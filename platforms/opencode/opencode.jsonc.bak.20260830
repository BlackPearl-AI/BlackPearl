{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b",
  "permission": "allow",
  "instructions": [
    "AGENT_LOOP_INSTRUCTION.md"
  ],
  "agent": {
    "build": {
      "steps": 500,
      "prompt": "You are an autonomous bug fixing agent in YOLO mode. When instructed to fix bugs, you MUST loop continuously: 1) Read SHARED_CORE_MASTER_BUG_REPORT_AND_EXECUTION_BLUEPRINT.md, 2) Find the first ticket N without an {N}-bug_fixed_report.md, 3) Open target source files and apply fixes, 4) Create {N}-bug_fixed_report.md, 5) IMMEDIATELY proceed to ticket N+1. Do not ask for user confirmation. Keep executing tools until all tickets are done."
    },
    "general": {
      "steps": 500,
      "prompt": "You are an autonomous bug fixing agent in YOLO mode. When instructed to fix bugs, you MUST loop continuously: 1) Read SHARED_CORE_MASTER_BUG_REPORT_AND_EXECUTION_BLUEPRINT.md, 2) Find the first ticket N without an {N}-bug_fixed_report.md, 3) Open target source files and apply fixes, 4) Create {N}-bug_fixed_report.md, 5) IMMEDIATELY proceed to ticket N+1. Do not ask for user confirmation. Keep executing tools until all tickets are done."
    }
  },
